<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>baud</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>baud</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>sh.rubric.baud</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>baud</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_baud._udp</string>
		<string>_peer-baud._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>For video calls. The camera is on only while you're on one.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Rubric Labs Inc.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>So this Mac can reach your iPhone and your other devices on the same network, like at home. Away from home, baud doesn't use it.</string>
	<key>NSLocationUsageDescription</key>
	<string>To show the friends you choose where you are, only while you're sharing it in a chat. It goes straight to them, never to a server.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>To show the friends you choose where you are, only while you're sharing it in a chat. It goes straight to them, never to a server.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>For your voice on calls. baud only listens during a call you place or answer.</string>
</dict>
</plist>
